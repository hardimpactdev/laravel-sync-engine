{
    "name": "hardimpactdev/sync-engine",
    "description": "Local-first sync for Laravel: a per-scope change feed, a push endpoint and real-time pokes. Pairs with the TypeScript client @hardimpactdev/sync-engine.",
    "keywords": [
        "laravel",
        "sync",
        "local-first",
        "offline",
        "sqlite",
        "reverb"
    ],
    "homepage": "https://github.com/hardimpactdev/sync-engine-laravel",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Nick Retel",
            "email": "nick@hardimpact.dev",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4",
        "illuminate/contracts": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/support": "^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.13",
        "laravel/pint": "^1.32",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^5.3"
    },
    "autoload": {
        "psr-4": {
            "HardImpact\\SyncEngine\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "HardImpact\\SyncEngine\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "HardImpact\\SyncEngine\\SyncEngineServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "pest --parallel",
        "analyse": "phpstan analyse --memory-limit=1G",
        "format": "pint",
        "check": [
            "pint --test",
            "@analyse",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
